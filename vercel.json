{
  "framework": "nextjs",
  "buildCommand": "prisma generate && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily-deliver",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 10 * * *"
    }
  ]
}
